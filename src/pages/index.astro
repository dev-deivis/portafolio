---
import Layout   from '../layouts/Layout.astro';
import Navbar   from '../components/Navbar.astro';
import Hero     from '../components/Hero.astro';
import Historia from '../components/Historia.astro';
import About    from '../components/About.astro';
import Skills   from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import Contact  from '../components/Contact.astro';
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <Historia />
    <About />
    <Skills />
    <Projects />
    <Services />
    <Contact />
  </main>
</Layout>

<script>
  import { initGSAP } from '../scripts/gsap-init';
  /* GSAP + ScrollTrigger arrancan directamente al cargar la página.
     El Hero usa CSS animations puras — se inician solas al ser visibles. */
  initGSAP();
</script>
