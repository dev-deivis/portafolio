---
// About.astro — Sobre Mí
// Layout: texto grande izquierda + 3 tarjetas derecha (bg-raised, borde --line).
// Paleta: --accent azul eléctrico. Sin gradientes, sin morado/cian/verde.

const specs = [
  {
    label: 'ACTUAL',
    title: 'Full Stack Freelance',
    desc:  'Disponible para proyectos de desarrollo web, apps móviles y APIs REST.',
  },
  {
    label: 'STACK PRINCIPAL',
    title: 'Backend · Frontend · Mobile',
    desc:  'Laravel · Next.js · Flutter · PostgreSQL · Docker',
  },
  {
    label: 'EXPERIENCIA',
    title: 'Proyectos con Tráfico Real',
    desc:  'Plataformas desplegadas con autenticación y roles multinivel.',
  },
];
---

<section id="about" class="about">
  <div class="about-container">

    <span class="section-label">Sobre Mí</span>

    <div class="about-grid">

      <!-- Párrafo principal — texto grande sin caja, no tocar -->
      <div class="about-text">
        <h2 class="declaration">
          Construyo aplicaciones web<br />
          y móviles completas,<br />
          <span class="declaration-accent">del backend al frontend.</span>
        </h2>
        <p class="about-body">
          Analizo tu necesidad, propongo la solución más simple que resuelva el
          problema y te acompaño hasta el lanzamiento.
        </p>
        <p class="availability">
          <span class="avail-dot" aria-hidden="true"></span>
          Disponible &nbsp;·&nbsp; Respondo en menos de 24 h
        </p>
      </div>

      <!-- 3 tarjetas de specs -->
      <div class="specs-col">
        {specs.map(({ label, title, desc }) => (
          <div class="spec-card">
            <span class="spec-label">{label}</span>
            <h3 class="spec-title">{title}</h3>
            <p class="spec-desc">{desc}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Sección ── */
  .about {
    padding: 6rem 4rem 7rem;
    content-visibility: visible;
  }

  .about-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Etiqueta de sección */
  .section-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 2.5rem;
  }

  /* Grid: texto | tarjetas */
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: start;
  }

  /* ── Columna de texto ── */
  .declaration {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 1.5rem;
  }

  .declaration-accent {
    color: var(--accent);
  }

  .about-body {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 1.8rem;
    max-width: 480px;
  }

  .availability {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .avail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3ddc84;
    flex-shrink: 0;
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1;   transform: scale(1);   }
    50%       { opacity: 0.5; transform: scale(1.45); }
  }

  /* ── Columna de tarjetas ── */
  .specs-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .spec-card {
    background: #1c1c22;          /* más claro que --bg (#0a0a0c): contraste real */
    border: 1px solid #383840;    /* borde visible sobre negro, sin ser blanco */
    border-radius: 12px;
    padding: 1.6rem 1.8rem;
  }

  .spec-label {
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .spec-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }

  .spec-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .about { padding: 5rem 2rem 6rem; }
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 600px) {
    .about { padding: 4rem 1.5rem 5rem; }
    .declaration { font-size: clamp(1.6rem, 6vw, 2.2rem); }
  }
</style>
