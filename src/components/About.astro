---
// About.astro — Sobre Mí
// Layout: texto declarativo arriba + 3 ventanas de editor en fila.
// Sin React, sin librerías — Astro + CSS puro.
---

<section id="about" class="about">
  <div class="about-container">

    <span class="section-label">Sobre Mí</span>

    <!-- ── Texto declarativo ── -->
    <div class="about-text">
      <h2 class="declaration">
        Construyo aplicaciones web<br />
        y móviles completas,<br />
        <span class="declaration-accent">del backend al frontend.</span>
      </h2>
      <p class="about-body">
        Analizo tu necesidad, propongo la solución más simple que resuelva el
        problema y te acompaño hasta el lanzamiento.
      </p>
      <p class="availability">
        <span class="avail-dot" aria-hidden="true"></span>
        Disponible &nbsp;·&nbsp; Respondo en menos de 24 h
      </p>
    </div>

    <!-- ── 3 ventanas de editor en fila ── -->
    <div class="specs-row">

      <!-- Tarjeta 1: actual.ts -->
      <div class="spec-editor">
        <div class="editor-bar">
          <div class="editor-dots">
            <span class="e-dot"></span>
            <span class="e-dot"></span>
            <span class="e-dot"></span>
          </div>
          <div class="editor-tab">actual.ts</div>
        </div>
        <div class="editor-body">
          <div class="code-row">
            <span class="ln">1</span>
            <span class="cl"><span class="c-kw">const</span> <span class="c-id">actual</span> <span class="c-pu">=</span> <span class="c-pu">{</span></span>
          </div>
          <div class="code-row">
            <span class="ln">2</span>
            <span class="cl">  <span class="c-key">rol</span><span class="c-pu">:</span>       <span class="c-str">"Full Stack Freelance"</span><span class="c-pu">,</span></span>
          </div>
          <div class="code-row">
            <span class="ln">3</span>
            <span class="cl">  <span class="c-key">status</span><span class="c-pu">:</span>    <span class="c-str">"disponible"</span><span class="c-pu">,</span></span>
          </div>
          <div class="code-row">
            <span class="ln">4</span>
            <span class="cl">  <span class="c-key">respuesta</span><span class="c-pu">:</span> <span class="c-str">"&lt; 24h"</span><span class="c-pu">,</span></span>
          </div>
          <div class="code-row">
            <span class="ln">5</span>
            <span class="cl"><span class="c-pu">};</span></span>
          </div>
        </div>
      </div>

      <!-- Tarjeta 2: stack.ts -->
      <div class="spec-editor">
        <div class="editor-bar">
          <div class="editor-dots">
            <span class="e-dot"></span>
            <span class="e-dot"></span>
            <span class="e-dot"></span>
          </div>
          <div class="editor-tab">stack.ts</div>
        </div>
        <div class="editor-body">
          <div class="code-row">
            <span class="ln">1</span>
            <span class="cl"><span class="c-kw">const</span> <span class="c-id">stack</span> <span class="c-pu">=</span> <span class="c-pu">{</span></span>
          </div>
          <div class="code-row">
            <span class="ln">2</span>
            <span class="cl">  <span class="c-key">backend</span><span class="c-pu">:</span>  <span class="c-pu">[</span><span class="c-str">"Laravel"</span><span class="c-pu">,</span> <span class="c-str">"Node.js"</span><span class="c-pu">],</span></span>
          </div>
          <div class="code-row">
            <span class="ln">3</span>
            <span class="cl">  <span class="c-key">frontend</span><span class="c-pu">:</span> <span class="c-pu">[</span><span class="c-str">"React"</span><span class="c-pu">,</span> <span class="c-str">"Next.js"</span><span class="c-pu">],</span></span>
          </div>
          <div class="code-row">
            <span class="ln">4</span>
            <span class="cl">  <span class="c-key">mobile</span><span class="c-pu">:</span>   <span class="c-pu">[</span><span class="c-str">"Flutter"</span><span class="c-pu">],</span></span>
          </div>
          <div class="code-row">
            <span class="ln">5</span>
            <span class="cl">  <span class="c-key">db</span><span class="c-pu">:</span>       <span class="c-pu">[</span><span class="c-str">"PostgreSQL"</span><span class="c-pu">,</span> <span class="c-str">"MySQL"</span><span class="c-pu">]</span></span>
          </div>
          <div class="code-row">
            <span class="ln">6</span>
            <span class="cl"><span class="c-pu">};</span></span>
          </div>
        </div>
      </div>

      <!-- Tarjeta 3: experiencia.ts -->
      <div class="spec-editor">
        <div class="editor-bar">
          <div class="editor-dots">
            <span class="e-dot"></span>
            <span class="e-dot"></span>
            <span class="e-dot"></span>
          </div>
          <div class="editor-tab">experiencia.ts</div>
        </div>
        <div class="editor-body">
          <div class="code-row">
            <span class="ln">1</span>
            <span class="cl"><span class="c-kw">const</span> <span class="c-id">exp</span> <span class="c-pu">=</span> <span class="c-pu">{</span></span>
          </div>
          <div class="code-row">
            <span class="ln">2</span>
            <span class="cl">  <span class="c-key">tipo</span><span class="c-pu">:</span>  <span class="c-str">"Tráfico real"</span><span class="c-pu">,</span></span>
          </div>
          <div class="code-row">
            <span class="ln">3</span>
            <span class="cl">  <span class="c-key">infra</span><span class="c-pu">:</span> <span class="c-pu">[</span><span class="c-str">"Railway"</span><span class="c-pu">,</span> <span class="c-str">"Docker"</span><span class="c-pu">],</span></span>
          </div>
          <div class="code-row">
            <span class="ln">4</span>
            <span class="cl">  <span class="c-key">auth</span><span class="c-pu">:</span>  <span class="c-str">"roles multinivel"</span></span>
          </div>
          <div class="code-row">
            <span class="ln">5</span>
            <span class="cl"><span class="c-pu">};</span></span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Sección ── */
  .about {
    padding: 6rem 4rem 7rem;
    content-visibility: visible;
  }

  .about-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* Etiqueta de sección */
  .section-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: -1rem; /* compensa el gap del flex container */
  }

  /* ── Texto declarativo ── */
  .about-text {
    max-width: 600px;
  }

  .declaration {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 1.5rem;
  }

  .declaration-accent {
    color: var(--accent);
  }

  .about-body {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 1.8rem;
    max-width: 480px;
  }

  .availability {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .avail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3ddc84;
    flex-shrink: 0;
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1;   transform: scale(1);   }
    50%       { opacity: 0.5; transform: scale(1.45); }
  }

  /* ── Fila de tarjetas ── */
  .specs-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  /* ── Ventana de editor ── */
  .spec-editor {
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    /* Fondo un poco más oscuro que el body de la sección */
    background: var(--bg);
  }

  /* Barra superior del editor */
  .editor-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.85rem;
    background: var(--bg-raised);    /* ligeramente más claro que el cuerpo */
    border-bottom: 1px solid var(--line);
    min-height: 32px;
  }

  /* Los 3 puntos */
  .editor-dots {
    display: flex;
    gap: 5px;
    align-items: center;
    flex-shrink: 0;
  }

  .e-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);          /* neutral, no colores macOS */
  }

  /* Pestaña con el nombre de archivo */
  .editor-tab {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    background: var(--bg);            /* igual que el cuerpo → apariencia de pestaña activa */
    border: 1px solid var(--line);
    border-bottom: none;              /* se funde con el cuerpo */
    border-radius: 5px 5px 0 0;
    padding: 0.2rem 0.7rem 0.25rem;
    margin-bottom: -1px;             /* solapa con el border-bottom de la barra */
    white-space: nowrap;
  }

  /* Cuerpo del código */
  .editor-body {
    padding: 0.85rem 0;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.8;
    background: var(--bg);
  }

  /* Fila de código: número de línea + contenido */
  .code-row {
    display: flex;
    align-items: baseline;
    gap: 0;
    padding: 0 1rem;
  }

  /* Número de línea */
  .ln {
    display: inline-block;
    min-width: 1.6rem;
    text-align: right;
    padding-right: 1rem;
    color: var(--text-muted);
    opacity: 0.35;
    user-select: none;
    flex-shrink: 0;
  }

  /* Contenido de la línea — pre para preservar espacios de indentación */
  .cl {
    white-space: pre;
  }

  /* ── Sintaxis coloreada ── */
  /* keyword: const */
  .c-kw  { color: var(--text); font-style: italic; }
  /* identifier: nombre de variable */
  .c-id  { color: var(--text); }
  /* property keys (palabras antes de :) */
  .c-key { color: var(--text); }
  /* strings y valores entre comillas */
  .c-str { color: var(--accent); }
  /* puntuación: { } [ ] : , = ; */
  .c-pu  { color: var(--text-muted); opacity: 0.6; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .about { padding: 5rem 2rem 6rem; }
    .specs-row {
      grid-template-columns: 1fr;  /* apiladas en mobile */
      gap: 1rem;
    }
  }

  @media (max-width: 600px) {
    .about { padding: 4rem 1.5rem 5rem; }
    .declaration { font-size: clamp(1.6rem, 6vw, 2.2rem); }
    .editor-body { font-size: 0.76rem; }
  }
</style>
