---
// Hero — devdeivis
// Paleta negro + azul eléctrico (rediseño 2026)
// Foto integrada a la derecha (duotono negro + azul #2D5CFF) con position: absolute
const heroPhotoSrc = `${import.meta.env.BASE_URL}assets/images/projects/foto-hero.png`;
---

<section id="home" class="hero">

  <!-- Contenido principal (Texto y botones) -->
  <div class="hero-inner">

    <!-- Indicador de disponibilidad -->
    <div class="avail-badge" aria-label="Estado: disponible para proyectos">
      <span class="avail-dot" aria-hidden="true"></span>
      <span class="avail-label">Disponible para proyectos</span>
    </div>

    <!-- Handle / marca personal -->
    <p class="hero-handle">devdeivis</p>

    <!-- Nombre y rol — el corazón del Hero -->
    <h1 class="hero-name">
      David<br />Almaraz
    </h1>

    <p class="hero-role">
      Desarrollador Full Stack &amp; Freelancer
    </p>

    <!-- CTA -->
    <div class="hero-btns">
      <a href="#projects" class="btn btn-primary">Ver proyectos</a>
      <a href="#contact" class="btn btn-secondary">Hablemos</a>
    </div>

  </div>

  <!-- Foto de perfil duotono (Posicionada a la derecha de forma independiente) -->
  <div class="hero-photo-wrap" aria-hidden="true">
    <div class="hero-photo-filter">
      <img
        src={heroPhotoSrc}
        alt="David Almaraz"
        class="hero-photo-img"
        loading="eager"
      />
    </div>
    <!-- Fundido continuo a --bg en la base -->
    <div class="hero-photo-fade"></div>
  </div>

  <!-- Indicador de scroll -->
  <div class="scroll-hint" aria-hidden="true">
    <span class="scroll-line"></span>
    <span class="scroll-text">scroll</span>
  </div>

</section>

<style>
  /* ── Sección ── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    /* padding-top compensa la navbar fija */
    padding: 120px 4rem 6rem;
    position: relative;
    overflow: hidden;
  }

  /* Contenido alineado exactamente como estaba originalmente */
  .hero-inner {
    max-width: 760px;
    margin: 0 0 0 6vw;
    position: relative;
    z-index: 2;
  }

  /* ── Badge de disponibilidad ── */
  .avail-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    border-radius: 50px;
    padding: 0.35rem 1rem 0.35rem 0.75rem;
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.1s forwards;
  }

  .avail-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .avail-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }

  /* ── Handle ── */
  .hero-handle {
    font-family: var(--mono);
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.25s forwards;
  }

  /* ── Nombre — exactamente con la tipografía y escala original ── */
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(5.5rem, 15vw, 13rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.4s forwards;
  }

  /* ── Rol ── */
  .hero-role {
    font-family: var(--font);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 400;
    color: var(--text-muted);
    margin-bottom: 3rem;
    line-height: 1.5;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.6s forwards;
  }

  /* ── Botones ── */
  .hero-btns {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.8s forwards;
  }

  /* ── Foto de perfil duotono ── */
  .hero-photo-wrap {
    position: absolute;
    right: 3vw;
    bottom: 0;
    width: min(680px, 46vw);
    z-index: 1;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.45s forwards;
    pointer-events: none;
    user-select: none;
  }

  .hero-photo-filter {
    position: relative;
    width: 100%;
    /* Difuminado suave en los bordes */
    -webkit-mask-image: 
      linear-gradient(to right, transparent 0%, black 15%, black 88%, transparent 100%),
      linear-gradient(to bottom, black 65%, transparent 100%);
    -webkit-mask-composite: source-in, destination-in;
    mask-image: 
      linear-gradient(to right, transparent 0%, black 15%, black 88%, transparent 100%),
      linear-gradient(to bottom, black 65%, transparent 100%);
    mask-composite: intersect;
  }

  /* Filtro Duotono Puro + enfoque centrado en la mitad derecha */
  .hero-photo-img {
    width: 100%;
    height: auto;
    max-height: 88vh;
    object-fit: cover;
    object-position: 65% top;
    display: block;
    filter: grayscale(100%) sepia(100%) hue-rotate(195deg) saturate(380%) contrast(1.25) brightness(0.9);
  }

  /* Fundido continuo con el color de fondo --bg */
  .hero-photo-fade {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  /* ── Scroll hint — alineación original perfecta ── */
  .scroll-hint {
    position: absolute;
    bottom: 3rem;
    left: calc(6vw + 4px); /* alineado exactamente con el borde original de hero-inner */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 1.1s forwards;
    z-index: 3;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--accent);
    animation: lineDown 1.8s ease-in-out infinite;
  }

  .scroll-text {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  /* ── Keyframes ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1);   opacity: 1; }
    50%       { transform: scale(1.5); opacity: 0.6; }
  }

  @keyframes lineDown {
    0%   { top: -100%; }
    100% { top:  100%; }
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .hero-photo-wrap {
      width: min(500px, 42vw);
      right: 1vw;
    }
  }

  @media (max-width: 960px) {
    .hero {
      padding: 110px 1.5rem 4rem;
      position: relative;
    }
    .hero-inner {
      margin: 0;
      width: 100%;
      max-width: 100%;
      position: relative;
      z-index: 2;
    }
    .hero-name {
      font-size: clamp(3.2rem, 11vw, 4.8rem);
      line-height: 0.95;
      max-width: 62%; /* Deja espacio a la derecha para la foto */
    }
    .hero-photo-wrap {
      position: absolute;
      right: 35px;
      top: 255px; /* Un poco más abajo y más a la izquierda */
      width: min(180px, 38vw);
      max-width: 180px;
      margin: 0;
      z-index: 1;
    }
    .hero-photo-img {
      max-height: 260px;
      object-fit: cover;
      object-position: top center;
    }
    .scroll-hint {
      left: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 100px 1.25rem 4rem;
    }
    .hero-name {
      font-size: clamp(2.8rem, 11vw, 4rem);
      line-height: 0.95;
      max-width: 60%;
    }
    .hero-btns {
      flex-direction: column;
    }
    .hero-photo-wrap {
      right: 20px; /* Desplazada más hacia la izquierda */
      top: 245px;  /* Un poco más abajo */
      width: 160px;
    }
    .hero-photo-img {
      max-height: 230px;
      object-position: top center;
    }
    .scroll-hint {
      display: none;
    }
  }
</style>
