---
// Hero — devdeivis
// Paleta negro + azul eléctrico (rediseño 2026)
// Foto integrada a la derecha (duotono negro + azul #2D5CFF) con position: absolute
const heroPhotoSrc = `${import.meta.env.BASE_URL}assets/images/projects/foto-hero.png`;
---

<section id="home" class="hero">

  <!-- Contenido principal (Texto y botones) -->
  <div class="hero-inner">

    <!-- Indicador de disponibilidad -->
    <div class="avail-badge" aria-label="Estado: disponible para proyectos">
      <span class="avail-dot" aria-hidden="true"></span>
      <span class="avail-label">Disponible para proyectos</span>
    </div>

    <!-- Handle / marca personal -->
    <p class="hero-handle">devdeivis</p>

    <!-- Nombre y rol — el corazón del Hero -->
    <h1 class="hero-name">
      <!-- Texto real para lectores de pantalla -->
      <span class="sr-only">David Almaraz</span>
      <!-- Capa animada: aria-hidden para que los screen readers la ignoren -->
      <span aria-hidden="true">
        <span class="decrypt-line" data-text="David" data-start-delay="500"></span><br>
        <span class="decrypt-line" data-text="Almaraz" data-start-delay="680"></span>
      </span>
    </h1>

    <p class="hero-role">
      <span class="sr-only">Desarrollador Full Stack &amp; Freelancer</span>
      <span aria-hidden="true" class="decrypt-line" data-text="Desarrollador Full Stack & Freelancer" data-start-delay="950"></span>
    </p>

    <!-- CTA -->
    <div class="hero-btns">
      <a href="#projects" class="btn btn-primary">Ver proyectos</a>
      <a href="#contact" class="btn btn-secondary">Hablemos</a>
    </div>

  </div>

  <!-- Foto de perfil duotono (Posicionada a la derecha de forma independiente) -->
  <div class="hero-photo-wrap" aria-hidden="true">
    <div class="hero-photo-filter">
      <img
        src={heroPhotoSrc}
        alt="David Almaraz"
        class="hero-photo-img"
        loading="eager"
      />
    </div>
    <!-- Fundido continuo a --bg en la base -->
    <div class="hero-photo-fade"></div>
  </div>

  <!-- Indicador de scroll -->
  <div class="scroll-hint" aria-hidden="true">
    <span class="scroll-line"></span>
    <span class="scroll-text">scroll</span>
  </div>

</section>

<style>
  /* ── Sección ── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    /* padding-top compensa la navbar fija */
    padding: 120px 4rem 6rem;
    position: relative;
    overflow: hidden;
  }

  /* Contenido alineado exactamente como estaba originalmente */
  .hero-inner {
    max-width: 760px;
    margin: 0 0 0 6vw;
    position: relative;
    z-index: 2;
  }

  /* ── Badge de disponibilidad ── */
  .avail-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    border-radius: 50px;
    padding: 0.35rem 1rem 0.35rem 0.75rem;
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.1s forwards;
  }

  .avail-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .avail-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }

  /* ── Handle ── */
  .hero-handle {
    font-family: var(--mono);
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.25s forwards;
  }

  /* ── Nombre — exactamente con la tipografía y escala original ── */
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(5.5rem, 15vw, 13rem);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.4s forwards;
  }

  /* ── Rol ── */
  .hero-role {
    font-family: var(--font);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 400;
    color: var(--text-muted);
    margin-bottom: 3rem;
    line-height: 1.5;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.6s forwards;
  }

  /* ── Botones ── */
  .hero-btns {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.8s forwards;
  }

  /* ── Foto de perfil duotono ── */
  .hero-photo-wrap {
    position: absolute;
    right: 3vw;
    bottom: 0;
    width: min(680px, 46vw);
    z-index: 1;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.45s forwards;
    pointer-events: none;
    user-select: none;
  }

  .hero-photo-filter {
    position: relative;
    width: 100%;
    /* Difuminado suave en los bordes */
    -webkit-mask-image: 
      linear-gradient(to right, transparent 0%, black 15%, black 88%, transparent 100%),
      linear-gradient(to bottom, black 65%, transparent 100%);
    -webkit-mask-composite: source-in, destination-in;
    mask-image: 
      linear-gradient(to right, transparent 0%, black 15%, black 88%, transparent 100%),
      linear-gradient(to bottom, black 65%, transparent 100%);
    mask-composite: intersect;
  }

  /* Filtro Duotono Puro + enfoque centrado en la mitad derecha */
  .hero-photo-img {
    width: 100%;
    height: auto;
    max-height: 88vh;
    object-fit: cover;
    object-position: 65% top;
    display: block;
    filter: grayscale(100%) sepia(100%) hue-rotate(195deg) saturate(380%) contrast(1.25) brightness(0.9);
  }

  /* Fundido continuo con el color de fondo --bg */
  .hero-photo-fade {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  /* ── Scroll hint — alineación original perfecta ── */
  .scroll-hint {
    position: absolute;
    bottom: 3rem;
    left: calc(6vw + 4px); /* alineado exactamente con el borde original de hero-inner */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 1.1s forwards;
    z-index: 3;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--accent);
    animation: lineDown 1.8s ease-in-out infinite;
  }

  .scroll-text {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  /* ── Decrypt Text Effect ── */
  .decrypt-line {
    display: inline;
  }

  /* Estado scramble: caracteres random en color apagado */
  .decrypt-line .dk-s {
    color: var(--text-muted);
    opacity: 0.5;
  }

  /* Lock-in: flash de acento que decae al color heredado del padre */
  .decrypt-line .dk-l {
    animation: decrypt-flash 420ms cubic-bezier(.2, 0, 0, 1) forwards;
  }

  @keyframes decrypt-flash {
    from {
      color: var(--accent);
      text-shadow: 0 0 22px rgba(45, 92, 255, 0.72);
    }
    to {
      color: inherit;
      text-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .decrypt-line .dk-l {
      animation: none;
      color: inherit;
    }
  }

  /* ── Keyframes ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1);   opacity: 1; }
    50%       { transform: scale(1.5); opacity: 0.6; }
  }

  @keyframes lineDown {
    0%   { top: -100%; }
    100% { top:  100%; }
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .hero-photo-wrap {
      width: min(500px, 42vw);
      right: 1vw;
    }
  }

  @media (max-width: 960px) {
    .hero {
      padding: 110px 1.5rem 4rem;
      position: relative;
    }
    .hero-inner {
      margin: 0;
      width: 100%;
      max-width: 100%;
      position: relative;
      z-index: 2;
    }
    .hero-name {
      font-size: clamp(3.2rem, 11vw, 4.8rem);
      line-height: 0.95;
      max-width: 62%; /* Deja espacio a la derecha para la foto */
    }
    .hero-photo-wrap {
      position: absolute;
      right: 35px;
      top: 255px; /* Un poco más abajo y más a la izquierda */
      width: min(180px, 38vw);
      max-width: 180px;
      margin: 0;
      z-index: 1;
    }
    .hero-photo-img {
      max-height: 260px;
      object-fit: cover;
      object-position: top center;
    }
    .scroll-hint {
      left: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 100px 1.25rem 4rem;
    }
    .hero-name {
      font-size: clamp(2.8rem, 11vw, 4rem);
      line-height: 0.95;
      max-width: 60%;
    }
    .hero-btns {
      flex-direction: column;
    }
    .hero-photo-wrap {
      right: 20px; /* Desplazada más hacia la izquierda */
      top: 245px;  /* Un poco más abajo */
      width: 160px;
    }
    .hero-photo-img {
      max-height: 230px;
      object-position: top center;
    }
    .scroll-hint {
      display: none;
    }
  }
</style>

<script is:inline>
(function () {
  'use strict';

  var POOL = '#%&@$?!*+=/{}[]<>~^';
  var STAGGER  = 45;   /* ms entre cada carácter que se bloquea */
  var SPEED    = 45;   /* ms mínimo entre ciclos de glifo */
  var JITTER   = 80;   /* ± spread aleatorio sobre el lock-time, en ms */
  var CYCLE_SPREAD = 35; /* jitter extra en el ciclo de scramble */

  /* Generador pseudoaleatorio (mulberry32) — sin Math.random global */
  function makeRng(seed) {
    var a = seed >>> 0;
    return function () {
      a = (a + 0x6d2b79f5) | 0;
      var t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  /* Anima una lista de <span> con el efecto decrypt */
  function playLine(spans, startDelay, seed) {
    var rng = makeRng(seed);
    var total = spans.length;
    var lockAt  = new Float64Array(total);
    var nextAt  = new Float64Array(total);
    var locked  = new Uint8Array(total);

    /* Inicializa cada span en estado scramble */
    spans.forEach(function (span, i) {
      var ch = span.dataset.real;
      span.textContent = (ch === ' ')
        ? '\u00A0'
        : POOL.charAt((rng() * POOL.length) | 0);
      if (ch !== ' ') span.className = 'dk-s';
      lockAt[i] = startDelay + i * STAGGER + (rng() * 2 - 1) * JITTER;
      nextAt[i] = 0;
    });

    var t0 = performance.now();
    var remaining = total;

    function frame() {
      var now = performance.now() - t0;
      for (var i = 0; i < total; i++) {
        if (locked[i]) continue;
        var span = spans[i];
        var real = span.dataset.real;

        if (now >= lockAt[i]) {
          /* Bloquear: mostrar carácter real + flash de acento */
          span.textContent = (real === ' ') ? '\u00A0' : real;
          span.className = 'dk-l';
          locked[i] = 1;
          remaining--;
        } else if (real !== ' ' && now >= nextAt[i]) {
          /* Seguir ciclando glifos random */
          span.textContent = POOL.charAt((rng() * POOL.length) | 0);
          nextAt[i] = now + SPEED + rng() * CYCLE_SPREAD;
        }
      }
      if (remaining > 0) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  function initDecrypt() {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('.decrypt-line').forEach(function (line, lineIdx) {
      var text       = line.dataset.text || '';
      var startDelay = parseInt(line.dataset.startDelay || '0', 10);

      /* Construye un <span> por carácter */
      var chars = Array.from(text);
      var spans = chars.map(function (ch) {
        var s = document.createElement('span');
        s.dataset.real = ch;
        return s;
      });

      line.innerHTML = '';
      spans.forEach(function (s) { line.appendChild(s); });

      if (reduced) {
        /* Sin animación: muestra el texto directamente */
        spans.forEach(function (s) { s.textContent = s.dataset.real; });
        return;
      }

      playLine(spans, startDelay, lineIdx * 7919 + 1);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDecrypt);
  } else {
    initDecrypt();
  }
}());
</script>
