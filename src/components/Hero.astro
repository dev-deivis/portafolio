---
// Hero — devdeivis
// Paleta negro + azul eléctrico (rediseño 2026)
// Foto integrada a la derecha (duotono negro + azul #2D5CFF)
const heroPhotoSrc = `${import.meta.env.BASE_URL}assets/images/projects/foto-hero.png`;
---

<section id="home" class="hero">
  <div class="hero-container">

    <!-- Columna izquierda: Información principal -->
    <div class="hero-inner">

      <!-- Indicador de disponibilidad -->
      <div class="avail-badge" aria-label="Estado: disponible para proyectos">
        <span class="avail-dot" aria-hidden="true"></span>
        <span class="avail-label">Disponible para proyectos</span>
      </div>

      <!-- Handle / marca personal -->
      <p class="hero-handle">devdeivis</p>

      <!-- Nombre y rol — el corazón del Hero -->
      <h1 class="hero-name">
        David<br />Almaraz
      </h1>

      <p class="hero-role">
        Desarrollador Full Stack &amp; Freelancer
      </p>

      <!-- CTA -->
      <div class="hero-btns">
        <a href="#projects" class="btn btn-primary">Ver proyectos</a>
        <a href="#contact" class="btn btn-secondary">Hablemos</a>
      </div>

    </div>

    <!-- Columna derecha: Foto de perfil duotono más grande y pegada -->
    <div class="hero-photo-wrap" aria-hidden="true">
      <div class="hero-photo-filter">
        <img
          src={heroPhotoSrc}
          alt="David Almaraz"
          class="hero-photo-img"
          loading="eager"
        />
      </div>
      <!-- Fundido continuo a --bg en base y laterales -->
      <div class="hero-photo-fade"></div>
    </div>

    <!-- Indicador de scroll -->
    <div class="scroll-hint" aria-hidden="true">
      <span class="scroll-line"></span>
      <span class="scroll-text">scroll</span>
    </div>

  </div>
</section>

<style>
  /* ── Sección Hero ── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 110px 4rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 540px;
    align-items: center;
    gap: 0;
    position: relative;
  }

  .hero-inner {
    max-width: 720px;
    margin-left: 2vw;
    position: relative;
    z-index: 2;
  }

  /* ── Badge de disponibilidad ── */
  .avail-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    border-radius: 50px;
    padding: 0.35rem 1rem 0.35rem 0.75rem;
    margin-bottom: 1.8rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.1s forwards;
  }

  .avail-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .avail-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
  }

  /* ── Handle ── */
  .hero-handle {
    font-family: var(--mono);
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.25s forwards;
  }

  /* ── Nombre ── */
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 8.5vw, 8.5rem);
    font-weight: 800;
    line-height: 0.90;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-bottom: 1.8rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.4s forwards;
  }

  /* ── Rol ── */
  .hero-role {
    font-family: var(--font);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-weight: 400;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    line-height: 1.5;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.6s forwards;
  }

  /* ── Botones ── */
  .hero-btns {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.6s ease 0.8s forwards;
  }

  /* ── Foto de perfil duotono (Columna Derecha: más grande y pegada a la izquierda) ── */
  .hero-photo-wrap {
    position: relative;
    width: 100%;
    max-width: 580px;
    margin-left: -5rem; /* Desplaza la foto hacia la izquierda, pegada a "David Almaraz" */
    z-index: 1;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.45s forwards;
    pointer-events: none;
    user-select: none;
  }

  .hero-photo-filter {
    position: relative;
    width: 100%;
    /* Máscara doble: difumina el borde izquierdo y la base inferior */
    -webkit-mask-image: 
      linear-gradient(to right, transparent 0%, black 18%, black 85%, transparent 100%),
      linear-gradient(to bottom, black 65%, transparent 100%);
    -webkit-mask-composite: source-in, destination-in;
    mask-image: 
      linear-gradient(to right, transparent 0%, black 18%, black 85%, transparent 100%),
      linear-gradient(to bottom, black 65%, transparent 100%);
    mask-composite: intersect;
  }

  /* Filtro Duotono Puro: Grayscale -> Sepia -> Hue Rotate (Azul Eléctrico #2D5CFF) */
  .hero-photo-img {
    width: 100%;
    height: auto;
    max-height: 86vh;
    object-fit: cover;
    object-position: top center;
    display: block;
    filter: grayscale(100%) sepia(100%) hue-rotate(195deg) saturate(380%) contrast(1.25) brightness(0.9);
  }

  /* Fundido continuo con el color de fondo --bg */
  .hero-photo-fade {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  /* ── Scroll hint ── */
  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: calc(2vw + 4px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    animation: fadeUp 0.6s ease 1.1s forwards;
    z-index: 3;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--accent);
    animation: lineDown 1.8s ease-in-out infinite;
  }

  .scroll-text {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  /* ── Keyframes ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1);   opacity: 1; }
    50%       { transform: scale(1.5); opacity: 0.6; }
  }

  @keyframes lineDown {
    0%   { top: -100%; }
    100% { top:  100%; }
  }

  /* ── Responsive ── */
  @media (max-width: 1200px) {
    .hero-container {
      grid-template-columns: 1fr 440px;
    }
    .hero-photo-wrap {
      max-width: 460px;
      margin-left: -2rem;
    }
  }

  @media (max-width: 960px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-inner {
      margin-left: 0;
    }
    .hero-photo-wrap {
      max-width: 360px;
      margin: 0 auto;
      justify-self: center;
    }
  }

  @media (max-width: 600px) {
    .hero { padding: 100px 1.5rem 4rem; }
    .hero-name { font-size: clamp(3rem, 12vw, 4.5rem); line-height: 0.95; }
    .hero-btns { flex-direction: column; }
    .hero-photo-wrap {
      max-width: 280px;
      margin: 0 auto;
    }
    .scroll-hint { display: none; }
  }
</style>
