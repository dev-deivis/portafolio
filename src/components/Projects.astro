---
// Projects.astro — Grid numerado 01 / 02 / 03
// Rediseño 2026: formato editorial estilo heynesh.com
// Animación: GSAP ScrollTrigger en .project-card (registrado en gsap-init.ts)

interface Project {
  index:     string;       // "01", "02", "03"
  id:        string;
  title:     string;
  desc:      string;
  tech:      string[];
  thumb?:    string;       // imagen de preview (primera slide del proyecto)
  links:     { label: string; href: string; primary?: boolean }[];
  status?:   'live' | 'wip';
  note?:     string;
}

const projects: Project[] = [
  {
    index: '01',
    id: 'hackathon',
    title: 'Gestión de Hackathones',
    desc: 'Sistema completo para gestionar eventos de hackathones — registro de equipos, evaluación de proyectos y generación automática de constancias en PDF. Más de 50 equipos y 20 eventos gestionados.',
    tech: ['Laravel 11', 'PostgreSQL', 'Supabase', 'TailwindCSS', 'Alpine.js', 'Railway'],
    thumb: '/assets/images/projects/hackathon-home.png',
    status: 'live',
    links: [
      { label: 'Demo en vivo',    href: 'https://web-production-ef44a.up.railway.app/', primary: true },
      { label: 'Código fuente',   href: 'https://github.com/dev-deivis/hackathon-events' },
    ],
  },
  {
    index: '02',
    id: 'voces',
    title: 'Voces Indígenas',
    desc: 'Plataforma web educativa para la documentación y preservación de 6 lenguas indígenas mexicanas. Incluye mapa interactivo con Leaflet.js y análisis de crisis lingüística.',
    tech: ['HTML5', 'CSS3', 'JavaScript', 'Leaflet.js'],
    thumb: '/assets/images/projects/voces-1.png',
    status: 'live',
    note: 'Presentado en exposición de preservación de lenguas indígenas',
    links: [
      { label: 'Ver página',  href: 'https://dev-deivis.github.io/voces_indigenas/', primary: true },
      { label: 'Ver código',  href: 'https://github.com/dev-deivis/voces_indigenas' },
    ],
  },
  {
    index: '03',
    id: 'medibot',
    title: 'MediBot',
    desc: 'App móvil de salud inteligente con asistente conversacional basado en IA. Orientada a facilitar el acceso a información médica básica para poblaciones con acceso limitado a servicios de salud.',
    tech: ['Flutter', 'Dart', 'IA'],
    status: 'wip',
    links: [],
  },
];
---

<section id="projects" class="projects">
  <div class="projects-container">

    <!-- Encabezado -->
    <div class="projects-header project-card">
      <span class="section-label">Proyectos</span>
      <h2 class="projects-title">
        Lo que he<br />construido
      </h2>
    </div>

    <!-- Lista de proyectos -->
    <div class="projects-list">
      {projects.map((p) => (
        <article class={`project-card project-row${p.status === 'wip' ? ' project-row--wip' : ''}`} id={`project-${p.id}`}>

          <!-- Separador superior -->
          <div class="row-divider" aria-hidden="true"></div>

          <div class="row-inner">
            <!-- Número de índice -->
            <span class="project-index" aria-hidden="true">{p.index}</span>

            <!-- Cuerpo del proyecto -->
            <div class="project-body">
              <div class="project-top">
                <div class="project-meta">
                  <!-- Status badge -->
                  {p.status === 'live' && (
                    <span class="status-badge status-live">
                      <span class="status-dot" aria-hidden="true"></span>
                      Live
                    </span>
                  )}
                  {p.status === 'wip' && (
                    <span class="status-badge status-wip">En desarrollo</span>
                  )}
                  {p.note && (
                    <span class="project-note">{p.note}</span>
                  )}
                </div>

                <!-- Thumbnail — solo si hay imagen y no es WIP -->
                {p.thumb && p.status !== 'wip' && (
                  <div class="project-thumb" aria-hidden="true">
                    <img
                      src={import.meta.env.BASE_URL + p.thumb.slice(1)}
                      alt=""
                      loading="lazy"
                    />
                  </div>
                )}
              </div>

              <h3 class="project-title">{p.title}</h3>
              <p class="project-desc">{p.desc}</p>

              <!-- Tags de stack -->
              <ul class="tech-pills" aria-label="Stack tecnológico">
                {p.tech.map((t) => <li class="tech-pill">{t}</li>)}
              </ul>

              <!-- Links -->
              {p.links.length > 0 && (
                <div class="project-links">
                  {p.links.map(({ label, href, primary }) => (
                    <a
                      href={href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={primary ? 'proj-link proj-link--primary' : 'proj-link'}
                    >
                      {label}
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>

        </article>
      ))}

      <!-- Separador final -->
      <div class="row-divider" aria-hidden="true"></div>
    </div>

  </div>
</section>

<style>
  /* ── Sección ── */
  .projects {
    padding: 8rem 4rem;
    content-visibility: visible;
  }

  .projects-container {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ── Encabezado ── */
  .projects-header {
    margin-bottom: 5rem;
  }

  .section-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 1.2rem;
  }

  .projects-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* ── Fila de proyecto ── */
  .row-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .project-row {
    padding: 3rem 0;
    transition: background 0.25s ease;
  }
  .project-row:hover {
    background: rgba(45, 92, 255, 0.03);
  }

  .row-inner {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
  }

  /* Número de índice */
  .project-index {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    padding-top: 0.3rem;
    flex-shrink: 0;
    width: 2rem;
    opacity: 0.5;
    transition: color 0.25s ease, opacity 0.25s ease;
  }
  .project-row:hover .project-index {
    color: var(--accent);
    opacity: 1;
  }

  /* Cuerpo */
  .project-body {
    flex: 1;
    min-width: 0;
  }

  /* Top row: meta + thumbnail */
  .project-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Status badges */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.7rem;
    border-radius: 50px;
  }

  .status-live {
    color: #4ade80;
    background: rgba(74, 222, 128, 0.08);
    border: 1px solid rgba(74, 222, 128, 0.25);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  .status-wip {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  /* Nota del proyecto */
  .project-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Thumbnail */
  .project-thumb {
    width: 100px;
    height: 66px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.06);
    opacity: 0.7;
    transition: opacity 0.25s ease;
  }
  .project-row:hover .project-thumb {
    opacity: 1;
  }
  .project-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* Título */
  .project-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
    line-height: 1.15;
    transition: color 0.25s ease;
  }
  .project-row:hover .project-title {
    color: #fff;
  }

  /* WIP — título muted */
  .project-row--wip .project-title {
    color: var(--text-muted);
  }

  /* Descripción */
  .project-desc {
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 1.2rem;
    max-width: 600px;
  }

  /* Pills de stack */
  .tech-pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.4rem;
  }

  .tech-pill {
    font-family: var(--mono);
    font-size: 0.67rem;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.7rem;
    border-radius: 4px;
    background: rgba(45, 92, 255, 0.08);
    border: 1px solid rgba(45, 92, 255, 0.22);
    color: rgba(180, 195, 255, 0.85);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .project-row:hover .tech-pill {
    background: rgba(45, 92, 255, 0.13);
    border-color: rgba(45, 92, 255, 0.38);
  }

  /* Links */
  .project-links {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .proj-link:hover {
    color: var(--text);
  }

  .proj-link--primary {
    color: var(--accent);
    font-weight: 600;
  }
  .proj-link--primary:hover {
    color: #6b8fff;
  }

  /* WIP — borde dashed sutil */
  .project-row--wip {
    opacity: 0.7;
  }

  /* Estado inicial para animación GSAP */
  .project-card {
    opacity: 0;
    transform: translateY(24px);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .projects { padding: 6rem 2rem; }
    .row-inner { gap: 1.5rem; }
    .project-thumb { width: 80px; height: 52px; }
  }

  @media (max-width: 600px) {
    .projects { padding: 5rem 1.5rem; }
    .projects-header { margin-bottom: 3rem; }
    .project-index { display: none; }
    .row-inner { gap: 0; }
    .project-thumb { display: none; }
    .project-row { padding: 2rem 0; }
  }
</style>
