---
// Projects.astro — Grid numerado 01–06
// Rediseño 2026: formato editorial estilo heynesh.com
// Animación: GSAP ScrollTrigger en .project-card (registrado en gsap-init.ts)

interface Project {
  index:      string;       // "01" … "06"
  id:         string;
  title:      string;
  desc:       string;
  impact:     string;       // "Qué resolví" — debajo del desc, antes de los tags
  tech:       string[];
  thumb?:     string;       // imagen de preview (primera slide del proyecto)
  accentRGB:  string;       // "R,G,B" para el placeholder cuando no hay thumb
  links:      { label: string; href: string; primary?: boolean }[];
  status?:    'live' | 'wip';
  note?:      string;
}

const projects: Project[] = [
  {
    index: '01',
    id: 'lunisa',
    title: 'Lunisa',
    desc: 'App offline de IA que analiza fotos de parcela y datos climáticos de 68 municipios para recomendar el cultivo óptimo a agricultores zapotecos de Oaxaca.',
    impact: 'Permite tomar decisiones de siembra basadas en datos, sin depender de conexión a internet, en comunidades con acceso limitado.',
    tech: ['HTML', 'Python', 'Computer Vision', 'Flutter'],
    accentRGB: '108,99,255',
    status: 'live',
    links: [
      { label: 'Ver código', href: 'https://github.com/dev-deivis/lu-nisa' },
    ],
  },
  {
    index: '02',
    id: 'mappache',
    title: 'MappAche',
    desc: 'App móvil + dashboard municipal que detecta y prioriza baches en Oaxaca usando visión por computadora.',
    impact: 'Automatiza la priorización de reparación vial, reemplazando reportes ciudadanos dispersos y poco confiables.',
    tech: ['Flutter', 'Dart', 'Roboflow', 'Gemini API'],
    accentRGB: '0,229,255',
    status: 'live',
    note: 'Categoría Móvil · HackaTec 2026',
    links: [
      { label: 'Ver código', href: 'https://github.com/dev-deivis/MappAche' },
    ],
  },
  {
    index: '03',
    id: 'reservaciones',
    title: 'Sistema de Reservaciones ITO',
    desc: 'Sistema fullstack para gestionar reservaciones de aulas, laboratorios y salas del ITO, con API REST y autenticación JWT.',
    impact: 'Eliminó el proceso manual en papel para reservar espacios, con control de acceso por roles de usuario.',
    tech: ['Node.js', 'Express', 'React', 'Vite', 'PostgreSQL'],
    accentRGB: '0,255,163',
    status: 'live',
    links: [
      { label: 'Ver código', href: 'https://github.com/dev-deivis/sistema-reservaciones-ito' },
    ],
  },
  {
    index: '04',
    id: 'lariscan',
    title: 'LariScan',
    desc: 'Web app con YOLOv8 (94.2% de precisión) para detectar defectos en telas automáticamente vía cámara móvil o imagen.',
    impact: 'Reduce la inspección manual en producción textil, acelerando el control de calidad con precisión medible.',
    tech: ['FastAPI', 'YOLOv8', 'Next.js', 'TypeScript'],
    accentRGB: '108,99,255',
    status: 'live',
    links: [
      { label: 'Ver código', href: 'https://github.com/dev-deivis/LariScan' },
    ],
  },
  {
    index: '05',
    id: 'aprendia',
    title: 'Aprendia',
    desc: 'App móvil con Claude API que guía a adultos mexicanos a terminar primaria/secundaria vía INEA, con voz y avatar animado.',
    impact: 'Da acompañamiento accesible (con voz) a personas que abandonaron la escuela, facilitando su regreso a través de INEA.',
    tech: ['Flutter', 'Dart', 'Claude API'],
    accentRGB: '0,255,163',
    status: 'live',
    links: [
      { label: 'Ver código', href: 'https://github.com/dev-deivis/aprendia' },
    ],
  },
  {
    index: '06',
    id: 'tienda-san-jose',
    title: 'Tienda San José',
    desc: 'Tienda en línea para artículos religiosos de un negocio familiar en Florida, con pagos vía Stripe y envíos gestionados con Shippo.',
    impact: 'Le dio presencia digital y capacidad de venta en línea a un negocio que antes dependía solo de venta física.',
    tech: ['Next.js', 'Prisma', 'MySQL', 'Stripe', 'Shippo'],
    accentRGB: '245,158,11',
    status: 'live',
    note: 'Proyecto de cliente — repositorio privado',
    links: [],
  },
];
---

<section id="projects" class="projects">
  <div class="projects-container">

    <!-- Encabezado -->
    <div class="projects-header project-card">
      <span class="section-label">Proyectos</span>
      <h2 class="projects-title">
        Lo que he<br />construido
      </h2>
    </div>

    <!-- Lista de proyectos -->
    <div class="projects-list">
      {projects.map((p) => (
        <article class={`project-card project-row${p.status === 'wip' ? ' project-row--wip' : ''}`} id={`project-${p.id}`}>

          <!-- Separador superior -->
          <div class="row-divider" aria-hidden="true"></div>

          <!-- Cabecera de fila: índice + status -->
          <div class="row-header">
            <span class="project-index">{p.index}</span>
            <div class="project-meta">
              {p.status === 'live' && (
                <span class="status-badge status-live">
                  <span class="status-dot" aria-hidden="true"></span>
                  Live
                </span>
              )}
              {p.status === 'wip' && (
                <span class="status-badge status-wip">En desarrollo</span>
              )}
              {p.note && <span class="project-note">{p.note}</span>}
            </div>
          </div>

          <!-- Imagen de preview — ancho completo, 16:9 -->
          <div class="project-visual">
            {p.thumb ? (
              <img
                src={import.meta.env.BASE_URL + p.thumb.slice(1)}
                alt={`Preview de ${p.title}`}
                loading="lazy"
              />
            ) : (
              <!-- Placeholder genérico con color de acento del proyecto -->
              <div class="visual-placeholder" aria-hidden="true">
                <svg
                  class="wf-svg"
                  viewBox="0 0 800 450"
                  xmlns="http://www.w3.org/2000/svg"
                  preserveAspectRatio="xMidYMid slice"
                >
                  <defs>
                    <pattern id={`dots-${p.id}`} x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
                      <circle cx="1.5" cy="1.5" r="1.5" fill={`rgba(${p.accentRGB},0.18)`} />
                    </pattern>
                  </defs>

                  <!-- Fondo -->
                  <rect width="800" height="450" fill={`rgba(${p.accentRGB},0.03)`} />
                  <rect width="800" height="450" fill={`url(#dots-${p.id})`} />

                  <!-- Número de índice grande, muy sutil -->
                  <text
                    x="400" y="260"
                    text-anchor="middle" dominant-baseline="middle"
                    font-family="'JetBrains Mono', monospace"
                    font-size="200" font-weight="700" letter-spacing="-8"
                    fill={`rgba(${p.accentRGB},0.05)`}
                  >{p.index}</text>

                  <!-- Líneas decorativas horizontales -->
                  <line x1="100" y1="180" x2="700" y2="180" stroke={`rgba(${p.accentRGB},0.08)`} stroke-width="1"/>
                  <line x1="100" y1="270" x2="700" y2="270" stroke={`rgba(${p.accentRGB},0.06)`} stroke-width="1"/>

                  <!-- Título del proyecto -->
                  <text
                    x="400" y="400"
                    text-anchor="middle"
                    font-family="'JetBrains Mono', monospace"
                    font-size="11" letter-spacing="4"
                    fill={`rgba(${p.accentRGB},0.32)`}
                  >{p.title.toUpperCase()}</text>
                </svg>
              </div>
            )}
          </div>

          <!-- Texto debajo de la imagen -->
          <div class="project-body">
            <h3 class="project-title">{p.title}</h3>
            <p class="project-desc">{p.desc}</p>
            <p class="project-impact">{p.impact}</p>

            <ul class="tech-pills" aria-label="Stack tecnológico">
              {p.tech.map((t) => <li class="tech-pill">{t}</li>)}
            </ul>

            {p.links.length > 0 && (
              <div class="project-links">
                {p.links.map(({ label, href, primary }) => (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={primary ? 'proj-link proj-link--primary' : 'proj-link'}
                  >
                    {label}
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                ))}
              </div>
            )}
          </div>

        </article>
      ))}

      <!-- Separador final -->
      <div class="row-divider" aria-hidden="true"></div>
    </div>

  </div>
</section>

<style>
  /* ── Sección ── */
  .projects {
    padding: 8rem 4rem;
    content-visibility: visible;
  }

  .projects-container {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ── Encabezado ── */
  .projects-header {
    margin-bottom: 5rem;
  }

  .section-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 1.2rem;
  }

  .projects-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* ── Separador ── */
  .row-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  /* ── Fila de proyecto ── */
  .project-row {
    padding: 1.8rem 0 2.6rem;
  }

  /* Cabecera: índice + status, en una línea */
  .row-header {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1.4rem;
  }

  .project-index {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    opacity: 0.5;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Status badges */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.7rem;
    border-radius: 50px;
  }

  .status-live {
    color: #4ade80;
    background: rgba(74, 222, 128, 0.08);
    border: 1px solid rgba(74, 222, 128, 0.25);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  .status-wip {
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .project-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
  }

  /* ── Imagen a ancho completo, ratio 16:9 ── */
  .project-visual {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-raised);
    border: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 1.8rem;
  }

  .project-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.5s ease;
  }
  .project-row:hover .project-visual img {
    transform: scale(1.02);
  }

  /* Placeholder MediBot — ocupa todo el contenedor, SVG interno */
  .visual-placeholder {
    width: 100%;
    height: 100%;
    border: 1px dashed rgba(245, 158, 11, 0.25);
    border-radius: 10px;
    overflow: hidden;
  }

  .wf-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── Texto debajo de la imagen ── */
  .project-body {
    /* sin restricción de ancho — la imagen ya marcó la pauta */
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.015em;
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .project-row--wip .project-title {
    color: var(--text-muted);
  }

  .project-desc {
    font-size: 0.93rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  /* Línea de impacto / "Qué resolví" */
  .project-impact {
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--text-muted);
    opacity: 0.65;
    font-style: italic;
    margin-bottom: 1.1rem;
    padding-left: 0.9rem;
    border-left: 2px solid rgba(255, 255, 255, 0.1);
  }

  /* Pills de stack */
  .tech-pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.4rem;
  }

  .tech-pill {
    font-family: var(--mono);
    font-size: 0.67rem;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.7rem;
    border-radius: 4px;
    background: rgba(45, 92, 255, 0.08);
    border: 1px solid rgba(45, 92, 255, 0.22);
    color: rgba(180, 195, 255, 0.85);
  }

  /* Links */
  .project-links {
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .proj-link:hover { color: var(--text); }

  .proj-link--primary {
    color: var(--accent);
    font-weight: 600;
  }
  .proj-link--primary:hover { color: #6b8fff; }

  /* WIP — opacidad reducida */
  .project-row--wip { opacity: 0.7; }

  /* Estado inicial para animación GSAP */
  .project-card {
    opacity: 0;
    transform: translateY(24px);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .projects { padding: 6rem 2rem; }
  }

  @media (max-width: 600px) {
    .projects { padding: 5rem 1.5rem; }
    .projects-header { margin-bottom: 3rem; }
    .project-row { padding: 1.5rem 0 2rem; }
  }
</style>
