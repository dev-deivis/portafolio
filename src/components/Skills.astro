---

<section id="skills" class="skills reveal-section">
  <div class="container">

    <!-- Encabezado -->
    <div class="skills-header">
      <span class="section-label">Proceso & Stack</span>
      <h2 class="skills-title">
        De la Idea<br />al Producto
      </h2>
      <p class="skills-sub">Cómo convierto tu visión en software que funciona</p>
    </div>

    <!-- Proceso: 4 tarjetas -->
    <div class="steps-grid">
      {steps.map((s) => (
        <div class="glass-card step-card skill-card">
          <div class="step-bar" aria-hidden="true"></div>
          <div class="step-top">
            <span class="step-num">{s.num}</span>
            <div class="step-icon" set:html={s.icon}></div>
          </div>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-desc">{s.desc}</p>
        </div>
      ))}
    </div>

    <!-- Stack tecnológico -->
    <div class="tech-wrap">
      <span class="tech-eyebrow">Stack tecnológico</span>

      <!-- Grid de Tarjetas Stack -->
      <div class="tech-grid">
        {techGroups.map((g) => (
          <div class={`tech-col ${g.isWide ? 'tech-col--wide' : ''}`}>
            <div class="col-header">
              <div class="col-icon" set:html={g.icon}></div>
              <span class="col-label">{g.label}</span>
            </div>
            <div class="col-items">
              {g.techs.map((t) => (
                <div class="tech-item">
                  {'icon' in t && (
                    <img src={`https://skillicons.dev/icons?i=${t.icon}&theme=dark`} alt={t.name} width="24" height="24" loading="lazy" />
                  )}
                  {'si' in t && (
                    <img src={`https://cdn.simpleicons.org/${t.si}${'siColor' in t ? `/${t.siColor}` : ''}`} alt={t.name} width="20" height="20" loading="lazy" class="si-icon" />
                  )}
                  {'svg' in t && (
                    <span class="inline-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <Fragment set:html={t.svg} />
                      </svg>
                    </span>
                  )}
                  <span>{t.name}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Barra inferior de características -->
      <div class="features-bar">
        {features.map((f) => (
          <div class="feature-item">
            <div class="feature-icon" set:html={f.icon}></div>
            <div class="feature-text">
              <span class="feature-title">{f.title}</span>
              <span class="feature-desc">{f.desc}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .skills { background: rgba(0, 0, 0, 0.15); }

  /* ── Encabezado ── */
  .skills-header {
    margin-bottom: 4rem;
  }

  .section-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 1.2rem;
  }

  .skills-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .skills-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 420px;
  }

  /* ── Proceso ── */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .step-card {
    padding: 1.8rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .step-card:hover {
    transform: translateY(-8px);
    border-color: rgba(45, 92, 255, 0.4);
  }

  .step-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    opacity: 0.5;
    transition: opacity 0.3s;
  }
  .step-card:hover .step-bar { opacity: 1; }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.3rem;
  }

  .step-num {
    width: 34px; height: 34px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(45, 92, 255, 0.1);
    border: 1.5px solid rgba(45, 92, 255, 0.35);
    color: var(--accent);
  }

  .step-icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(45, 92, 255, 0.08);
    border: 1px solid rgba(45, 92, 255, 0.2);
    color: var(--accent);
    transition: background 0.3s;
  }
  .step-card:hover .step-icon {
    background: rgba(45, 92, 255, 0.15);
  }

  .step-title { font-size: 0.98rem; font-weight: 700; line-height: 1.3; }
  .step-desc  { font-size: 0.85rem; color: var(--text-muted); line-height: 1.7; flex: 1; }

  /* ── Stack tecnológico ── */
  .tech-wrap {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .tech-eyebrow {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 2rem;
  }

  /* CSS Grid de 3 columnas para las tarjetas */
  .tech-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 1.25rem !important;
  }

  /* Estilos de cada tarjeta de categoría */
  .tech-col {
    background: rgba(10, 16, 30, 0.65);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(45, 92, 255, 0.22);
    border-radius: 14px;
    padding: 1.4rem 1.4rem;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }
  .tech-col:hover {
    background: rgba(15, 24, 45, 0.75);
    border-color: rgba(45, 92, 255, 0.45);
    box-shadow: 0 8px 30px -5px rgba(45, 92, 255, 0.15);
  }

  .tech-col--wide {
    grid-column: span 2 !important;
  }

  /* Encabezado con Icono + Label */
  .col-header {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.75rem !important;
    margin-bottom: 1.2rem !important;
  }

  .col-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(45, 92, 255, 0.12);
    border: 1px solid rgba(45, 92, 255, 0.3);
    color: var(--accent, #3b82f6);
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0;
  }

  .col-icon :global(svg) {
    width: 18px;
    height: 18px;
    color: #3b82f6;
  }

  .col-label {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #3b82f6;
  }

  /* Grid interna para las pastillas/pills */
  .col-items {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 0.75rem !important;
    width: 100%;
  }

  /* Pastillas de tecnologías */
  .tech-item {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: all 0.2s ease;
    cursor: default;
    width: 100%;
    box-sizing: border-box;
  }
  .tech-item:hover {
    background: rgba(45, 92, 255, 0.09);
    border-color: rgba(45, 92, 255, 0.3);
    transform: translateY(-2px);
  }

  .tech-item img       { width: 22px; height: 22px; border-radius: 4px; flex-shrink: 0; }
  .tech-item .si-icon  { width: 20px; height: 20px; border-radius: 3px; flex-shrink: 0; opacity: 0.9; }
  .tech-item span      { font-size: 0.88rem; font-weight: 500; color: var(--text); }

  .inline-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
  }

  /* ── Barra inferior de características ── */
  .features-bar {
    margin-top: 1.25rem;
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    background: rgba(10, 16, 30, 0.65);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(45, 92, 255, 0.22);
    border-radius: 14px;
    padding: 1.25rem 0.5rem;
  }

  .feature-item {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.85rem;
    padding: 0.4rem 1.2rem;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }
  .feature-item:last-child {
    border-right: none;
  }

  .feature-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(45, 92, 255, 0.1);
    border: 1px solid rgba(45, 92, 255, 0.25);
    color: #3b82f6;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0;
  }

  .feature-icon :global(svg) {
    width: 20px;
    height: 20px;
    color: #3b82f6;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .feature-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text, #fff);
    line-height: 1.2;
  }

  .feature-desc {
    font-size: 0.76rem;
    color: var(--text-muted, #94a3b8);
    line-height: 1.3;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr) !important; }
    .tech-grid { grid-template-columns: repeat(2, 1fr) !important; }
    .tech-col--wide { grid-column: span 2 !important; }
    .features-bar {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 1rem;
      padding: 1.25rem;
    }
    .feature-item { border-right: none; }
  }

  @media (max-width: 550px) {
    .steps-grid { grid-template-columns: 1fr !important; }
    .tech-grid { grid-template-columns: 1fr !important; }
    .tech-col--wide { grid-column: span 1 !important; }
    .col-items { grid-template-columns: 1fr !important; }
    .features-bar { grid-template-columns: 1fr !important; }
  }
</style>
