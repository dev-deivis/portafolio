      { name: 'Gemini API',      svg: '<defs><linearGradient id="gemini-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4E88D4"/><stop offset="50%" stop-color="#9B51E0"/><stop offset="100%" stop-color="#E861A4"/></linearGradient></defs><path d="M12 2C12 7.52 7.52 12 2 12C7.52 12 12 16.48 12 22C12 16.48 16.48 12 22 12C16.48 12 12 7.52 12 2Z" fill="url(#gemini-grad)"/>' },
