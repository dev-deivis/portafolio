---
// Skills.astro — De la Idea al Producto + Stack Tecnológico
// Paleta unificada: --accent azul eléctrico. Sin morado/cian/verde/menta.

const steps = [
  {
    num:   '01',
    title: 'Análisis',
    desc:  'Entiendo tu idea, el problema que resuelve y a quién va dirigido.',
    icon:  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`,
  },
  {
    num:   '02',
    title: 'Diseño & Arquitectura',
    desc:  'Propongo la solución técnica más simple y escalable para tu caso.',
    icon:  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
  },
  {
    num:   '03',
    title: 'Desarrollo',
    desc:  'Construyo el producto con código limpio siguiendo buenas prácticas.',
    icon:  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
  {
    num:   '04',
    title: 'Deploy & Soporte',
    desc:  'Lanzo tu aplicación y te acompaño las primeras semanas.',
    icon:  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>`,
  },
];

const techGroups = [
  {
    label: 'Frontend',
    techs: [
      { name: 'React',   icon: 'react'   },
      { name: 'Next.js', icon: 'nextjs'  },
    ],
  },
  {
    label: 'Backend',
    techs: [
      { name: 'Laravel', icon: 'laravel' },
      { name: 'Node.js', icon: 'nodejs'  },
    ],
  },
  {
    label: 'Bases de datos',
    techs: [
      { name: 'MySQL',      icon: 'mysql'      },
      { name: 'PostgreSQL', icon: 'postgresql' },
    ],
  },
  {
    label: 'Herramientas',
    techs: [
      { name: 'Docker', icon: 'docker' },
      { name: 'Git',    icon: 'git'    },
    ],
  },
];
---

<section id="skills" class="skills reveal-section">
  <div class="container">
    <h2 class="section-title">De la Idea al Producto</h2>
    <p class="section-subtitle">Cómo convierto tu visión en software que funciona</p>

    <!-- Proceso: 4 tarjetas -->
    <div class="steps-grid">
      {steps.map((s) => (
        <div class="glass-card step-card skill-card">
          <div class="step-bar" aria-hidden="true"></div>
          <div class="step-top">
            <span class="step-num">{s.num}</span>
            <div class="step-icon" set:html={s.icon} />
          </div>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-desc">{s.desc}</p>
        </div>
      ))}
    </div>

    <!-- Stack tecnológico -->
    <div class="tech-wrap">
      <span class="tech-eyebrow">Stack tecnológico</span>

      <div class="tech-grid">
        {techGroups.map((g) => (
          <div class="tech-col">
            <span class="col-label">{g.label}</span>
            <div class="col-items">
              {g.techs.map((t) => (
                <div class="tech-item">
                  <img
                    src={`https://skillicons.dev/icons?i=${t.icon}&theme=dark`}
                    alt={t.name}
                    width="24"
                    height="24"
                    loading="lazy"
                  />
                  <span>{t.name}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skills { background: rgba(0, 0, 0, 0.15); }

  /* ── Proceso ── */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .step-card {
    padding: 1.8rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .step-card:hover {
    transform: translateY(-8px);
    border-color: rgba(45, 92, 255, 0.4);
  }

  /* Barra superior — azul eléctrico para todos */
  .step-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    opacity: 0.5;
    transition: opacity 0.3s;
  }
  .step-card:hover .step-bar { opacity: 1; }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.3rem;
  }

  /* Número — azul eléctrico unificado */
  .step-num {
    width: 34px; height: 34px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(45, 92, 255, 0.1);
    border: 1.5px solid rgba(45, 92, 255, 0.35);
    color: var(--accent);
  }

  /* Icono — azul eléctrico unificado */
  .step-icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(45, 92, 255, 0.08);
    border: 1px solid rgba(45, 92, 255, 0.2);
    color: var(--accent);
    transition: background 0.3s;
  }
  .step-card:hover .step-icon {
    background: rgba(45, 92, 255, 0.15);
  }

  .step-title { font-size: 0.98rem; font-weight: 700; line-height: 1.3; }
  .step-desc  { font-size: 0.85rem; color: var(--text-muted); line-height: 1.7; flex: 1; }

  /* ── Stack tecnológico ── */
  .tech-wrap {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .tech-eyebrow {
    display: block;
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }

  /* Columna — borde superior azul para todas */
  .tech-col {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-top: 2px solid rgba(45, 92, 255, 0.4);
    border-radius: 12px;
    padding: 1.4rem 1.2rem;
    transition: background 0.3s, border-color 0.3s;
  }
  .tech-col:hover {
    background: rgba(45, 92, 255, 0.04);
    border-color: rgba(45, 92, 255, 0.3);
    border-top-color: var(--accent);
  }

  .col-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .col-items {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: background 0.2s, transform 0.2s;
    cursor: default;
  }
  .tech-item:hover {
    background: rgba(45, 92, 255, 0.08);
    transform: translateX(4px);
  }

  .tech-item img  { width: 24px; height: 24px; border-radius: 4px; flex-shrink: 0; }
  .tech-item span { font-size: 0.88rem; font-weight: 500; color: var(--text); }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .steps-grid { grid-template-columns: repeat(2, 1fr); }
    .tech-grid  { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .steps-grid { grid-template-columns: 1fr; }
    .tech-grid  { grid-template-columns: repeat(2, 1fr); }
  }
</style>
