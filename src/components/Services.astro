---
// Services.astro — Servicios freelance
// Paleta unificada: --accent azul eléctrico, sin tokens de color por tarjeta

interface Service {
  num:      string;
  title:    string;
  desc:     string;
  features: string[];
  icon:     string;
}

const services: Service[] = [
  {
    num:  '01',
    title: 'Desarrollo Web',
    desc:  'Aplicaciones web de alto rendimiento con frameworks modernos. Desde landing pages hasta sistemas complejos con autenticación, APIs REST y paneles de administración.',
    features: ['Laravel & Node.js', 'React & Next.js', 'APIs REST escalables'],
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  },
  {
    num:  '02',
    title: 'Soluciones Móviles',
    desc:  'Apps multiplataforma para Android construidas con Flutter. Desde el diseño hasta la integración con APIs y publicación en tienda.',
    features: ['Flutter & Dart', 'Integración con APIs REST', 'Android'],
    icon: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>',
  },
  {
    num:  '03',
    title: 'Backend & Bases de Datos',
    desc:  'Diseño e implementación de APIs robustas y esquemas de base de datos optimizados. Autenticación, migraciones, consultas eficientes y despliegue en la nube.',
    features: ['PostgreSQL & MySQL', 'APIs con autenticación', 'Docker & Railway'],
    icon: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
  },
];
---

<section id="services" class="services">
  <div class="services-container">

    <!-- Encabezado -->
    <div class="services-header service-card">
      <span class="section-label">Servicios</span>
      <h2 class="services-title">
        Qué puedo<br />construir para ti
      </h2>
    </div>

    <!-- Grid de 3 tarjetas -->
    <div class="services-grid">
      {services.map(({ num, title, desc, features, icon }) => (
        <div class="svc-card service-card">
          <!-- Número decorativo de fondo -->
          <span class="svc-num" aria-hidden="true">{num}</span>

          <!-- Icono -->
          <div class="svc-icon">
            <svg
              width="20" height="20" viewBox="0 0 24 24"
              fill="none" stroke="currentColor"
              stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
            >
              <Fragment set:html={icon} />
            </svg>
          </div>

          <h3 class="svc-title">{title}</h3>
          <p class="svc-desc">{desc}</p>

          <ul class="svc-features">
            {features.map((f) => (
              <li class="svc-feature">
                <span class="feature-dot" aria-hidden="true"></span>
                {f}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="svc-cta service-card">
      <p class="svc-cta-label">¿Tienes un proyecto en mente?</p>
      <a href="#contact" class="btn btn-primary">Hablemos</a>
    </div>

  </div>
</section>

<style>
  /* ── Sección ── */
  .services {
    padding: 8rem 4rem;
    background: var(--bg-raised);
    content-visibility: visible;
  }

  .services-container {
    max-width: 960px;
    margin: 0 auto;
  }

  /* ── Encabezado ── */
  .services-header {
    margin-bottom: 5rem;
  }

  .section-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 1.2rem;
  }

  .services-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* ── Grid ── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5px;  /* borde compartido: separador fino entre tarjetas */
    background: rgba(255, 255, 255, 0.07); /* el color del gap actúa como borde */
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 5rem;
  }

  /* ── Tarjeta de servicio ── */
  .svc-card {
    background: var(--bg-raised);
    padding: 2.4rem 2rem;
    position: relative;
    overflow: hidden;  /* contiene el svc-num dentro de la tarjeta */
    transition: background 0.25s ease;
  }
  .svc-card:hover {
    background: rgba(45, 92, 255, 0.04);
  }

  /* Línea superior animada en hover */
  .svc-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  .svc-card:hover::before {
    transform: scaleX(1);
  }

  /* Número decorativo — marca de agua en esquina inferior derecha.
     bottom/right negativos + overflow:hidden en la tarjeta lo recortan
     de forma visible, sin riesgo de invadir columnas adyacentes. */
  .svc-num {
    position: absolute;
    bottom: -0.6rem;
    right: 0.6rem;
    font-family: var(--mono);
    font-size: 4.5rem;
    font-weight: 900;
    color: var(--accent);
    opacity: 0.07;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    transition: opacity 0.3s ease;
  }
  .svc-card:hover .svc-num {
    opacity: 0.14;
  }

  /* Icono */
  .svc-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(45, 92, 255, 0.08);
    border: 1px solid rgba(45, 92, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    margin-bottom: 1.5rem;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .svc-card:hover .svc-icon {
    background: rgba(45, 92, 255, 0.15);
    border-color: rgba(45, 92, 255, 0.4);
  }

  /* Textos */
  .svc-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.7rem;
    letter-spacing: -0.01em;
  }

  .svc-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 1.5rem;
  }

  /* Features */
  .svc-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .svc-feature {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .feature-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
    opacity: 0.7;
  }

  /* CTA */
  .svc-cta {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .svc-cta-label {
    font-size: 1.1rem;
    color: var(--text-muted);
    flex: 1;
  }

  /* Estado inicial para animación GSAP */
  .service-card {
    opacity: 0;
    transform: translateY(24px);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .services { padding: 6rem 2rem; }
    .services-grid { grid-template-columns: 1fr; }
    .svc-cta { flex-direction: column; align-items: flex-start; gap: 1.2rem; }
  }

  @media (max-width: 600px) {
    .services { padding: 5rem 1.5rem; }
    .services-header { margin-bottom: 3rem; }
  }
</style>
