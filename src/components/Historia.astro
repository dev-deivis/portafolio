---
// Historia.astro — Timeline horizontal pineado (desktop) / vertical (mobile)
// Desktop: GSAP ScrollTrigger pin + horizontal scrub  (gsap-init.ts)
// Mobile:  layout vertical con fade-in normal

const hitos = [
  {
    year: '2022 (Ago)',
    tag: 'Origen',
    title: 'Ingreso al ITO Oaxaca',
    desc: 'Entré a Ingeniería en Sistemas Computacionales en el Instituto Tecnológico de Oaxaca.',
  },
  {
    year: '2023',
    tag: 'Freelance',
    title: 'Inicio de Appoax',
    desc: 'Comencé como freelance full stack bajo la marca Appoax, desarrollando soluciones web y móviles para negocios locales de Oaxaca.',
  },
  {
    year: '2025',
    tag: 'Certificación',
    title: 'Huawei HCIA-Cloud',
    desc: 'Obtuve la certificación HCIA-Cloud Computing V5.5 de Huawei. Fundamentos de arquitectura en la nube, virtualización y servicios IaaS/PaaS.',
  },
  {
    year: '2025–2026',
    tag: 'Servicio',
    title: 'Técnico TI — TecNM',
    desc: 'Servicio social como técnico en mantenimiento, redes y desarrollo de software en TecNM campus Oaxaca (Dic 2025 – Jun 2026).',
  },
  {
    year: '2026',
    tag: 'Hackathon',
    title: 'MappAche — HackaTec 2026',
    desc: 'Desarrollé MappAche, app móvil + dashboard municipal que detecta y prioriza baches en Oaxaca usando visión por computadora. Participación en la categoría móvil de HackaTec 2026.',
  },
  {
    year: '2026',
    tag: 'Ahora',
    title: 'Freelance remoto & Appoax',
    desc: 'Buscando proyectos freelance y trabajo remoto mientras escalo Appoax. Disponible para proyectos que valga la pena construir.',
    current: true,
  },
];
---

<section id="historia" class="historia">

  <!-- Panel izquierdo: se queda fijo mientras el track se desliza -->
  <div class="historia-header">
    <span class="section-label">Mi Historia</span>
    <h2 class="historia-title">
      Cómo llegué<br />hasta aquí
    </h2>
  </div>

  <!-- Máscara de degradado — cubre el panel izquierdo en desktop -->
  <div class="historia-mask" aria-hidden="true"></div>

  <!-- Track horizontal: GSAP lo desplaza con translateX en desktop -->
  <div class="historia-track" id="historia-track">

    <!-- Riel horizontal -->
    <div class="track-rail" aria-hidden="true"></div>

    {hitos.map((hito) => (
      <article class={`hito${hito.current ? ' hito--current' : ''}`}>

        <!-- Año: zona superior -->
        <div class="hito-upper">
          <span class="hito-year">{hito.year}</span>
        </div>

        <!-- Nodo en el riel -->
        <div class="hito-node" aria-hidden="true">
          <div class="hito-dot"></div>
        </div>

        <!-- Contenido: zona inferior -->
        <div class="hito-lower">
          <span class="hito-tag">{hito.tag}</span>
          <h3 class="hito-title">{hito.title}</h3>
          <p class="hito-desc">{hito.desc}</p>
        </div>

      </article>
    ))}
  </div>

</section>

<style>
  /* ════════════════════════════════════════
     DESKTOP — scroll horizontal pineado
     (≥ 768px)
  ════════════════════════════════════════ */
  .historia {
    position: relative;
    height: 100vh;
    overflow: hidden;
    /* Neutraliza section { padding: 7rem 4rem } de global.css */
    padding: 0;
    /* ScrollTrigger necesita medir y repintar este elemento en tiempo real */
    content-visibility: visible !important;
    contain-intrinsic-size: none !important;
  }

  /* Panel de encabezado: posición absoluta a la izquierda, centrado vertical */
  .historia-header {
    position: absolute;
    left: 4rem;
    top: 50%;
    transform: translateY(-50%);
    width: 220px;
    z-index: 5;
    pointer-events: none;
  }

  .section-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 1.2rem;
  }

  .historia-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  /* Máscara: degradado sobre el panel izquierdo para que los hitos
     desaparezcan suavemente al deslizarse debajo del header */
  .historia-mask {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    /* ancho = zona del header + un poco de margen */
    width: calc(220px + 7rem);
    background: linear-gradient(
      to right,
      var(--bg) 55%,
      transparent 100%
    );
    z-index: 4;
    pointer-events: none;
  }

  /* Track: flex-row, se desplaza con GSAP translateX */
  .historia-track {
    display: flex;
    align-items: stretch;
    height: 100%;
    /* Empieza después del panel del header */
    padding-left: calc(220px + 7rem);
    padding-right: 6rem;
    position: relative;
    will-change: transform;
  }

  /* Riel horizontal — línea a mitad de la sección */
  .track-rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgba(255, 255, 255, 0.13);
    pointer-events: none;
  }

  /* Cada hito: columna vertical de ancho fijo */
  .hito {
    width: clamp(340px, 30vw, 460px);
    flex-shrink: 0;
    height: 100%;
    /* Grid: zona superior | nodo | zona inferior */
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    padding: 0 2.5rem;
    position: relative;
  }

  /* Zona superior: año alineado al fondo (justo sobre el riel) */
  .hito-upper {
    display: flex;
    align-items: flex-end;
    padding-bottom: 1.4rem;
  }

  .hito-year {
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  /* Nodo sobre el riel */
  .hito-node {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hito-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid rgba(255, 255, 255, 0.28);
    transition: border-color 0.3s ease;
  }

  .hito:hover .hito-dot {
    border-color: rgba(45, 92, 255, 0.6);
  }

  /* Nodo activo (Ahora) */
  .hito--current .hito-dot {
    width: 14px;
    height: 14px;
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-dim), 0 0 16px rgba(45, 92, 255, 0.5);
    animation: nodePulse 2.4s ease-in-out infinite;
  }

  @keyframes nodePulse {
    0%, 100% { box-shadow: 0 0 0 5px var(--accent-dim), 0 0 16px rgba(45,92,255,0.4); }
    50%       { box-shadow: 0 0 0 8px var(--accent-dim), 0 0 24px rgba(45,92,255,0.65); }
  }

  /* Zona inferior: contenido del hito */
  .hito-lower {
    padding-top: 1.4rem;
  }

  .hito-tag {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    display: block;
    margin-bottom: 0.55rem;
  }

  .hito-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.8rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .hito-desc {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-muted);
    max-width: 340px;
  }

  /* ════════════════════════════════════════
     MOBILE — timeline vertical normal
     (< 768px)
  ════════════════════════════════════════ */
  @media (max-width: 767px) {
    .historia {
      height: auto;
      overflow: visible;
      padding: 5rem 1.5rem 6rem;
    }

    /* Header: block normal, con estado inicial para GSAP */
    .historia-header {
      position: static;
      transform: none;
      width: auto;
      pointer-events: auto;
      margin-bottom: 3.5rem;
      opacity: 0;
      translate: 0 28px;
    }

    /* La máscara no aplica en mobile */
    .historia-mask {
      display: none;
    }

    /* Track: columna vertical */
    .historia-track {
      display: flex;
      flex-direction: column;
      height: auto;
      padding: 0 0 0 1.8rem;
      position: relative;
      will-change: auto;
    }

    /* Riel vertical en mobile */
    .track-rail {
      position: absolute;
      left: 5px;
      top: 0;
      bottom: 0;
      right: auto;
      width: 1px;
      height: auto;
      /* top: 50% del desktop ya no aplica */
      top: 0;
    }

    /* Hito: fila vertical */
    .hito {
      width: auto;
      height: auto;
      display: flex;
      flex-direction: column;
      grid-template-rows: none;
      padding: 0 0 3rem 0;
      opacity: 0;
      translate: 0 28px;
    }
    .hito:last-child {
      padding-bottom: 0;
    }

    /* Año encima del título, sin zona upper */
    .hito-upper {
      display: block;
      padding-bottom: 0;
      margin-bottom: 0.35rem;
    }

    /* Nodo: posición absoluta sobre el riel vertical */
    .hito-node {
      position: absolute;
      left: -1.8rem;
      top: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 14px;
    }

    .hito-lower {
      padding-top: 0;
    }

    .hito-title {
      font-size: clamp(1.1rem, 4vw, 1.4rem);
    }

    .hito-desc {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .historia { padding: 4rem 1.25rem 5rem; }
    .historia-title { font-size: clamp(2rem, 8vw, 2.8rem); }
  }
</style>
